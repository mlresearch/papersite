#!/usr/bin/env bash
# =============================================================================
# pmlint — PMLR volume lint (check / fix)
# =============================================================================
#
# USAGE:
#   cd ~/mlresearch/v350   # or r0, r201, …
#   pmlint --check         # intake: BibTeX + PDFs (pre-publication)
#   pmlint --fix
#   pmlint posts --check   # published volumes: validate _posts YAML
#   pmlint posts --check --changed
#   pmlint --check v350    # explicit id (also accepts bare 350 → v350)
#   pmlint --check r0 proceedings.bib
#
# Volume ids: vNNN (normal) or rNNN (rerelease). Bare numbers mean v<number>.
#
# Environment:
#   PAPERSITE_ROOT       Override papersite checkout
#   PMLINT_SKIP_UPDATE=1   Skip git fetch / fast-forward (CI / offline)
#   PMLINT_CACHE_DIR     Cache clone path (default: ~/.local/share/papersite)
#   PMLINT_DIFF_BASE     Git ref for posts --changed (default HEAD^)
#
# Exit codes:
#   0  All checks passed
#   1  One or more checks failed (or usage / update error)
# =============================================================================

set -euo pipefail

DEFAULT_CACHE="${PMLINT_CACHE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/papersite}"
MODE="check"
SCOPE="intake"   # intake | posts
UNICODE_CHECK=0
FORCE=0
CHANGED=0
DIFF_BASE=""
VOLUME_ARG=""
BIBFILE=""
POST_FILES=()

usage() {
  cat <<'EOF'
Usage:
  pmlint [--check|--fix] [--unicode] [--force] [VOLUME] [BIBFILE]
  pmlint posts --check [--changed] [--base REF] [VOLUME] [POST_FILES...]

Intake (default — pre-publication BibTeX / PDF checks):
  --check     Read-only validation (default). Does not modify the volume tree.
  --fix       Apply safe non-interactive BibTeX repairs (percent escaping),
              then re-check.
  --unicode   Also run tidy_bib_unicode --strict (output only under /tmp).
  --force     Run intake even if the volume looks already published.

Posts (published volumes — FAQ _posts YAML corrections):
  posts --check     Validate _posts/*.md YAML / frontmatter / consistency
  --changed         Only posts changed vs --base / PMLINT_DIFF_BASE / HEAD^
  --base REF        Diff base for --changed

VOLUME is optional when the current directory (or origin repo name) is
vNNN or rNNN (rereleases). A bare number means v<number>.

Intake: if origin (or local) has a gh-pages branch, pmlint exits 0 without
checking, unless --force. Use `pmlint posts --check` for published volumes.

Environment:
  PAPERSITE_ROOT      Papersite checkout (optional)
  PMLINT_SKIP_UPDATE=1  Skip git fetch / fast-forward
  PMLINT_CACHE_DIR    Cache clone (default: ~/.local/share/papersite)
  PMLINT_DIFF_BASE    Default git ref for posts --changed

Install once:
  bash path/to/papersite/bin/install-pmlint
EOF
}

if [[ "${1:-}" == "posts" ]]; then
  SCOPE="posts"
  shift
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --check) MODE="check"; shift ;;
    --fix) MODE="fix"; shift ;;
    --unicode) UNICODE_CHECK=1; shift ;;
    --force) FORCE=1; shift ;;
    --changed) CHANGED=1; shift ;;
    --base)
      if [[ $# -lt 2 ]]; then
        echo "ERROR: --base requires a git ref" >&2
        exit 1
      fi
      DIFF_BASE="$2"
      shift 2
      ;;
    -h|--help) usage; exit 0 ;;
    -*)
      echo "ERROR: Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      if [[ "$SCOPE" == "posts" ]]; then
        if [[ "$1" == *.md || "$1" == _posts/* || "$1" == */_posts/* ]]; then
          POST_FILES+=("$1")
        elif [[ -z "$VOLUME_ARG" && ( "$1" =~ ^[0-9]+$ || "$1" =~ ^[vr][0-9]+$ ) ]]; then
          VOLUME_ARG="$1"
        elif [[ -z "$VOLUME_ARG" ]]; then
          VOLUME_ARG="$1"
        else
          POST_FILES+=("$1")
        fi
      else
        if [[ -z "$VOLUME_ARG" ]]; then
          VOLUME_ARG="$1"
        elif [[ -z "$BIBFILE" ]]; then
          BIBFILE="$1"
        else
          echo "ERROR: Unexpected argument: $1" >&2
          exit 1
        fi
      fi
      shift
      ;;
  esac
done

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

normalize_volume_id() {
  local raw="$1"
  if [[ "$raw" =~ ^[0-9]+$ ]]; then
    printf 'v%s\n' "$raw"
  elif [[ "$raw" =~ ^[vr][0-9]+$ ]]; then
    printf '%s\n' "$raw"
  else
    return 1
  fi
}

infer_volume_id() {
  local name="" remote=""
  name="$(basename "$(pwd)")"
  if normalize_volume_id "$name" >/dev/null 2>&1; then
    normalize_volume_id "$name"
    return
  fi
  if remote="$(git remote get-url origin 2>/dev/null)"; then
    name="$(basename "$remote")"
    name="${name%.git}"
    if normalize_volume_id "$name" >/dev/null 2>&1; then
      normalize_volume_id "$name"
      return
    fi
  fi
  if [[ -n "${GITHUB_REPOSITORY:-}" ]]; then
    name="${GITHUB_REPOSITORY##*/}"
    if normalize_volume_id "$name" >/dev/null 2>&1; then
      normalize_volume_id "$name"
      return
    fi
  fi
  return 1
}

VOLUME=""
if [[ "$SCOPE" != "posts" ]]; then
  if [[ -n "$VOLUME_ARG" ]]; then
    if ! VOLUME="$(normalize_volume_id "$VOLUME_ARG")"; then
      echo "ERROR: Volume must be vNNN, rNNN, or a bare number (got: $VOLUME_ARG)" >&2
      usage >&2
      exit 1
    fi
  else
    if ! VOLUME="$(infer_volume_id)"; then
      echo "ERROR: Could not infer volume id from directory or git remote." >&2
      echo "       Run from a vNNN/rNNN repo, or pass the id explicitly." >&2
      usage >&2
      exit 1
    fi
  fi
fi

is_papersite_root() {
  local root="$1"
  [[ -f "$root/lib/check_volume.rb" && -f "$root/lib/tidy_bibtex.rb" ]]
}

resolve_papersite_root() {
  if [[ -n "${PAPERSITE_ROOT:-}" ]]; then
    if ! is_papersite_root "$PAPERSITE_ROOT"; then
      echo "ERROR: PAPERSITE_ROOT=$PAPERSITE_ROOT does not look like a papersite checkout" >&2
      exit 1
    fi
    printf '%s\n' "$PAPERSITE_ROOT"
    return
  fi

  local sibling
  sibling="$(cd .. 2>/dev/null && pwd)/papersite"
  if is_papersite_root "$sibling"; then
    printf '%s\n' "$sibling"
    return
  fi

  local from_script
  from_script="$(cd "$SCRIPT_DIR/.." && pwd)"
  if is_papersite_root "$from_script"; then
    printf '%s\n' "$from_script"
    return
  fi

  if is_papersite_root "$DEFAULT_CACHE"; then
    printf '%s\n' "$DEFAULT_CACHE"
    return
  fi

  echo "ERROR: Cannot find papersite. Set PAPERSITE_ROOT, keep a sibling ../papersite," >&2
  echo "       or run: bash <papersite>/bin/install-pmlint" >&2
  exit 1
}

self_update() {
  local root="$1"
  if [[ "${PMLINT_SKIP_UPDATE:-}" == "1" ]]; then
    echo "==> Skipping papersite update (PMLINT_SKIP_UPDATE=1)"
    return
  fi

  if [[ ! -d "$root/.git" ]]; then
    echo "ERROR: $root is not a git checkout; cannot self-update" >&2
    echo "       Set PMLINT_SKIP_UPDATE=1 to continue without updating" >&2
    exit 1
  fi

  echo "==> Updating papersite at $root"
  (
    cd "$root"
    if [[ -n "$(git status --porcelain 2>/dev/null)" ]]; then
      echo "ERROR: papersite working tree is dirty; refuse to auto-update:" >&2
      git status --short >&2
      echo "       Commit/stash changes, or set PMLINT_SKIP_UPDATE=1" >&2
      exit 1
    fi
    git fetch origin
    local branch remote_ref
    branch="$(git rev-parse --abbrev-ref HEAD)"
    if [[ "$branch" == "HEAD" ]]; then
      branch="main"
    fi
    if git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
      remote_ref="origin/$branch"
    elif git show-ref --verify --quiet "refs/remotes/origin/main"; then
      remote_ref="origin/main"
    else
      echo "ERROR: No origin/main (or origin/$branch) after fetch" >&2
      exit 1
    fi
    local local_sha remote_sha
    local_sha="$(git rev-parse HEAD)"
    remote_sha="$(git rev-parse "$remote_ref")"
    if [[ "$local_sha" == "$remote_sha" ]]; then
      echo "    Already up to date (${local_sha:0:12})"
    else
      echo "    Fast-forwarding ${local_sha:0:12} -> ${remote_sha:0:12}"
      git merge --ff-only "$remote_ref"
    fi
  )
}

resolve_volume_dir() {
  local vol="$1"
  if [[ -d "$vol" ]]; then
    printf '%s\n' "$(cd "$vol" && pwd)"
  elif [[ "$(basename "$(pwd)")" == "$vol" ]]; then
    printf '%s\n' "$(pwd)"
  elif [[ "$vol" == v* && -d "${vol#v}" ]]; then
    printf '%s\n' "$(cd "${vol#v}" && pwd)"
  else
    echo "ERROR: Cannot find volume directory for ${vol}" >&2
    exit 1
  fi
}

find_bib() {
  local vol_dir="$1"
  local explicit="$2"
  if [[ -n "$explicit" ]]; then
    if [[ -f "$vol_dir/$explicit" ]]; then
      printf '%s\n' "$vol_dir/$explicit"
      return
    fi
    if [[ -f "$explicit" ]]; then
      printf '%s\n' "$(cd "$(dirname "$explicit")" && pwd)/$(basename "$explicit")"
      return
    fi
    echo "ERROR: BibTeX file not found: $explicit" >&2
    exit 1
  fi
  local found=""
  local f
  for f in "$vol_dir"/*.bib; do
    [[ -e "$f" ]] || continue
    case "$(basename "$f")" in
      *_clean.bib|*_cleaned.bib) continue ;;
    esac
    found="$f"
    break
  done
  if [[ -z "$found" ]]; then
    echo "ERROR: No .bib file found in $vol_dir" >&2
    exit 1
  fi
  printf '%s\n' "$found"
}

section() {
  echo
  echo "==> $1"
}

# Stage results accumulated for the final rollup (name|pass|fail)
STAGE_NAMES=()
STAGE_RESULTS=()  # 0=pass, 1=fail

record_stage() {
  local name="$1" rc="$2"
  STAGE_NAMES+=("$name")
  STAGE_RESULTS+=("$rc")
  if [[ "$rc" -ne 0 ]]; then
    FAILED=1
    echo "    → stage FAILED"
  else
    echo "    → stage passed"
  fi
}

print_rollup() {
  local i n fail_n=0
  n=${#STAGE_NAMES[@]}
  for ((i = 0; i < n; i++)); do
    if [[ "${STAGE_RESULTS[$i]}" -ne 0 ]]; then
      fail_n=$((fail_n + 1))
    fi
  done
  echo
  echo "pmlint stages: $((n - fail_n)) passed, ${fail_n} failed"
  for ((i = 0; i < n; i++)); do
    if [[ "${STAGE_RESULTS[$i]}" -eq 0 ]]; then
      echo "  ✓ ${STAGE_NAMES[$i]}"
    else
      echo "  ✗ ${STAGE_NAMES[$i]}"
    fi
  done
}

FAILED=0

ROOT="$(resolve_papersite_root)"
export PAPERSITE_ROOT="$ROOT"
self_update "$ROOT"

LIB="$ROOT/lib"
BIN="$ROOT/bin"

# Resolve volume for posts without requiring a .bib / intake id when cwd has _posts.
if [[ "$SCOPE" == "posts" ]]; then
  if [[ -n "$VOLUME_ARG" ]]; then
    VOLUME="$(normalize_volume_id "$VOLUME_ARG")" || {
      echo "ERROR: Invalid volume id: $VOLUME_ARG (expected vNNN, rNNN, or bare number)" >&2
      exit 1
    }
    VOL_DIR="$(resolve_volume_dir "$VOLUME")"
  elif [[ -d "_posts" ]]; then
    VOLUME="${VOLUME_ARG:-$(basename "$(pwd)")}"
    VOL_DIR="$(pwd)"
  else
    VOLUME="$(
      if [[ -n "$VOLUME_ARG" ]]; then
        normalize_volume_id "$VOLUME_ARG"
      else
        infer_volume_id
      fi
    )" || {
      echo "ERROR: Could not infer volume id; pass vNNN or run from a volume directory with _posts/" >&2
      exit 1
    }
    VOL_DIR="$(resolve_volume_dir "$VOLUME")"
  fi

  if [[ "$MODE" != "check" ]]; then
    echo "ERROR: pmlint posts only supports --check (got --${MODE})" >&2
    exit 1
  fi

  echo "pmlint mode=posts/--check volume=${VOLUME}"
  echo "  papersite: $ROOT"
  echo "  volume:    $VOL_DIR"

  # check_posts parses bibtex_author via bibtex-ruby; ensure gem on CI runners
  # that only install Ruby (existing volume workflows have no bundle step).
  if ! ruby -e 'require "bibtex"' >/dev/null 2>&1; then
    section "Setup: install bibtex-ruby"
    gem install bibtex-ruby -v '~> 6.0' --no-document
  fi

  set +e
  section "Check: check_posts (_posts YAML)"
  POST_ARGS=(-d "$VOL_DIR")
  if [[ "$CHANGED" -eq 1 ]]; then
    POST_ARGS+=(--changed)
    if [[ -n "$DIFF_BASE" ]]; then
      POST_ARGS+=(--base "$DIFF_BASE")
    fi
  fi
  if [[ ${#POST_FILES[@]} -gt 0 ]]; then
    POST_ARGS+=("${POST_FILES[@]}")
  fi
  ruby "$LIB/check_posts.rb" "${POST_ARGS[@]}"
  record_stage "check_posts" $?
  set -e
  print_rollup
  echo
  if [[ "$FAILED" -eq 0 ]]; then
    echo "pmlint posts: PASSED"
    exit 0
  else
    cat >&2 <<EOF
pmlint posts: FAILED

How to fix
----------
Edit the reported _posts/*.md files so YAML frontmatter is valid and matches
the paper schema (layout, title, author, id, pdf; extras as {label, link}).
Display author/title should stay consistent with bibtex_author / tex_title
when those fields are present. Author lists are compared after BibTeX parse
of bibtex_author (family/given), not by substring.

Re-check:
  pmlint posts --check

Docs: https://github.com/mlresearch/papersite#lint-published-posts
EOF
    exit 1
  fi
fi

VOL_DIR="$(resolve_volume_dir "$VOLUME")"

echo "pmlint mode=$MODE volume=$VOLUME"
echo "  papersite: $ROOT"
echo "  volume:    $VOL_DIR"

# Skip lint once the volume has been published (gh-pages exists with site files).
# Do this before requiring a .bib — published main often has assets only.
volume_is_published() {
  local dir="$1"
  (
    cd "$dir" || exit 1
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 1

    local ref=""
    if git ls-remote --exit-code --heads origin gh-pages >/dev/null 2>&1; then
      if git fetch --depth 1 origin gh-pages >/dev/null 2>&1; then
        ref="FETCH_HEAD"
      fi
    fi
    if [[ -z "$ref" ]] && git show-ref --verify --quiet refs/remotes/origin/gh-pages; then
      ref="refs/remotes/origin/gh-pages"
    fi
    if [[ -z "$ref" ]] && git show-ref --verify --quiet refs/heads/gh-pages; then
      ref="refs/heads/gh-pages"
    fi
    [[ -n "$ref" ]] || exit 1

    if git cat-file -e "$ref:_config.yml" 2>/dev/null \
      || git cat-file -e "$ref:index.html" 2>/dev/null \
      || git ls-tree -d --name-only "$ref" _posts >/dev/null 2>&1; then
      exit 0
    fi
    exit 0
  )
}

if [[ "$FORCE" -ne 1 ]] && volume_is_published "$VOL_DIR"; then
  echo
  echo "pmlint: SKIPPED — volume looks already published (gh-pages present)."
  echo "         Intake lint is for pre-publication PRs only."
  echo "         Re-run with --force to lint anyway."
  exit 0
fi

# Empty template volumes (README + workflows only) have no .bib yet. Do not
# fail CI on workflow-only PRs; fail once PDFs or an incomplete drop appear
# without a .bib, or when a .bib is present and checks fail.
volume_awaits_submission() {
  local dir="$1"
  local f
  for f in "$dir"/*.bib; do
    [[ -e "$f" ]] || continue
    case "$(basename "$f")" in
      *_clean.bib|*_cleaned.bib) continue ;;
    esac
    return 1
  done
  for f in "$dir"/*.pdf; do
    [[ -e "$f" ]] || continue
    return 1
  done
  return 0
}

if [[ -z "$BIBFILE" ]] && volume_awaits_submission "$VOL_DIR"; then
  echo
  echo "pmlint: SKIPPED — no .bib or paper PDFs yet (empty volume awaiting submission)."
  echo "         Intake lint runs once proceedings files are added."
  exit 0
fi

BIB_PATH="$(find_bib "$VOL_DIR" "$BIBFILE")"
BIB_BASE="$(basename "$BIB_PATH")"
echo "  bib:       $BIB_PATH"

set +e

if [[ "$MODE" == "fix" ]]; then
  section "Fix: tidy_bibtex --fix-percent --fix-wrap-hyphens"
  ruby "$LIB/tidy_bibtex.rb" --fix-percent --fix-wrap-hyphens --quiet "$BIB_PATH" "$BIB_PATH"
  record_stage "tidy_bibtex --fix-percent --fix-wrap-hyphens" $?
fi

section "Check: tidy_bibtex --dry-run --strict --check-author-commas"
ruby "$LIB/tidy_bibtex.rb" --dry-run --strict --check-author-commas "$BIB_PATH"
record_stage "tidy_bibtex (strict / author commas)" $?

section "Check: check_volume (PDF placement, proceedings fields, …)"
(
  cd "$VOL_DIR"
  bash "$BIN/check_volume.sh" "$VOLUME" "$BIB_BASE"
)
record_stage "check_volume" $?

if [[ "$UNICODE_CHECK" -eq 1 ]]; then
  section "Check: tidy_bib_unicode --strict"
  TMP_OUT="$(mktemp "${TMPDIR:-/tmp}/pmlint_unicode.XXXXXX.bib")"
  ruby "$LIB/tidy_bib_unicode.rb" --strict --quiet "$BIB_PATH" "$TMP_OUT"
  record_stage "tidy_bib_unicode --strict" $?
  rm -f "$TMP_OUT"
fi

set -e

print_rollup

echo
if [[ "$FAILED" -eq 0 ]]; then
  echo "pmlint: PASSED"
  exit 0
else
  cat >&2 <<EOF
pmlint: FAILED

Note: check_volume's own \"Errors: 0 / ready for publication\" only covers
PDF/supp/proceedings-structure checks. A tidy_bibtex failure still fails pmlint.

How to fix
----------
Auto-fixable BibTeX issues (unescaped % in titles/abstracts):
  pmlint --fix${BIBFILE:+ ${BIBFILE}}

Then re-check:
  pmlint --check${BIBFILE:+ ${BIBFILE}}

(Or pass the volume id explicitly: pmlint --check ${VOLUME})

Manual fields (examples):
  - published = {YYYY-MM-DD}  — optional at submission; set when publishing
  - PDF/supp placement, author commas, non-ASCII keys — edit files, then re-check
  - Unicode without a mapping — add to papersite lib/unicode_replacements.yml

If pmlint is not installed
--------------------------
From a papersite checkout:
  bash ${ROOT}/bin/install-pmlint
  export PATH="\$HOME/.local/bin:\$PATH"

Or run without installing (sibling clone):
  PMLINT_SKIP_UPDATE=1 PAPERSITE_ROOT=${ROOT} ${ROOT}/bin/pmlint --check

Docs: https://github.com/mlresearch/papersite#lint-a-volume
EOF
  exit 1
fi
